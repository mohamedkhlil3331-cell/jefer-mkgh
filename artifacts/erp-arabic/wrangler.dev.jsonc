{
  "name": "jefer-erp-frontend-local",
  "main": "./cloudflare-dev-worker.ts",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ERP_API_ORIGIN": "http://127.0.0.1:8080"
  }
}
