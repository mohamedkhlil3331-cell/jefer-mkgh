{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jefer-erp-worker-validation",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_nodejs_http_modules",
    "enable_nodejs_http_server_modules"
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CHAT_REALTIME", "class_name": "ChatRealtimeRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatRealtimeRoom"] }
  ],
  "assets": {
    "directory": "../erp-arabic/dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "NODE_ENV": "production",
    "ERP_DATABASE_BACKEND": "d1",
    "ERP_D1_PRIMARY_DATABASE_ID": "bbeae386-5413-4c9d-8ea5-0f0417960591",
    "ERP_D1_REPLICA_DATABASE_ID": "fad39a1b-7a3e-453f-8195-ad72d44a7c91",
    "ERP_D1_REPLICATION_ENABLED": "1",
    "ERP_D1_PRODUCTS_ENABLED": "1",
    "ERP_D1_WAREHOUSES_ENABLED": "1",
    "ERP_OBJECT_STORAGE_BACKEND": "r2",
    "CLOUDFLARE_R2_ACCOUNT_ID": "7ec23c43e87f05d2f7b789b9981a206f",
    "CLOUDFLARE_R2_BUCKET_NAME": "jefer"
  },
  "d1_databases": [
    {
      "binding": "ERP_DB",
      "database_name": "jefer",
      "database_id": "bbeae386-5413-4c9d-8ea5-0f0417960591"
    },
    {
      "binding": "ERP_DB_REPLICA",
      "database_name": "jefer-production-replica",
      "database_id": "fad39a1b-7a3e-453f-8195-ad72d44a7c91"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ERP_OBJECTS",
      "bucket_name": "jefer"
    }
  ]
}
