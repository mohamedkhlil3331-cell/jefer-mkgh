{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jefer-erp-worker-validation",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_nodejs_http_modules",
    "enable_nodejs_http_server_modules"
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "CHAT_REALTIME", "class_name": "ChatRealtimeRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatRealtimeRoom"] }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "NODE_ENV": "development",
    "ERP_DATABASE_BACKEND": "d1",
    "ERP_D1_PRIMARY_DATABASE_ID": "00000000-0000-0000-0000-000000000001",
    "ERP_D1_REPLICA_DATABASE_ID": "00000000-0000-0000-0000-000000000002",
    "ERP_D1_REPLICATION_ENABLED": "1",
    "ERP_D1_PRODUCTS_ENABLED": "1",
    "ERP_D1_WAREHOUSES_ENABLED": "1",
    "ERP_OBJECT_STORAGE_BACKEND": "r2"
  },
  "d1_databases": [
    {
      "binding": "ERP_DB",
      "database_name": "jefer-erp-local-primary",
      "database_id": "00000000-0000-0000-0000-000000000001"
    },
    {
      "binding": "ERP_DB_REPLICA",
      "database_name": "jefer-erp-local-replica",
      "database_id": "00000000-0000-0000-0000-000000000002"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ERP_OBJECTS",
      "bucket_name": "jefer-erp-local-validation"
    }
  ]
}
