{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "if [ \"$NODE_ENV\" = \"production\" ]; then node --enable-source-maps ./dist/index.mjs; else mkdir -p data && flock -x -w 60 -E 75 data/erp.db.dev.lock env DEV_DB_WRITER_LOCK_HELD=1 node --enable-source-maps ./dist/index.mjs || { echo '[api] Could not acquire the development database writer lock; refusing to start a second writer.' >&2; exit 75; }; fi",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@replit/connectors-sdk": "^0.4.3",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "better-sqlite3": "^12.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.3",
    "pino": "^9",
    "pino-http": "^10",
    "web-push": "^3.6.7",
    "ws": "^8.22.0",
    "xlsx": "^0.18.5",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.1",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0"
  }
}
